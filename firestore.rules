rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Koleksi presensi: Publik boleh membaca dan check-in baru, dilarang update & delete (Spec 3.2)
    match /presensi_kegiatan/{presensiId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    // Koleksi submissions SPT
    match /submissions/{subId} {
      allow read, create, delete: if true;
    }

    // Koleksi konfigurasi kegiatan, OPD, dan template aktif
    match /config_kegiatan/{docId} {
      allow read, write: if true;
    }

    match /config_opd/{docId} {
      allow read, write: if true;
    }

    match /config_templates/{docId} {
      allow read, write: if true;
    }

    // Pengaturan unit kerja yang dikecualikan dari monitoring SPT
    match /config_monitoring/{docId} {
      allow read, write: if true;
    }

    // Branding aplikasi (nama aplikasi & teks footer laporan)
    match /config_branding/{docId} {
      allow read, write: if true;
    }
  }
}
